# ── Supabase (required) ───────────────────────────────────────────────────────
# Project Settings > API > Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings > API > anon / public key  (safe to expose in browser)
SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Vite build-time copies (used by client.ts for browser bundle)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Project Settings > API > service_role key  (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Drizzle migrations (optional, only needed when running drizzle-kit) ───────
LOVABLE_DB_MIGRATION_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
